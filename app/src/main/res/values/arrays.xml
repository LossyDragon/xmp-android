<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Preference: Theme Key -->
    <string-array name="themeListArray">
        <item>@string/pref_theme_array_auto</item>
        <item>@string/pref_theme_array_dark</item>
        <item>@string/pref_theme_array_light</item>
    </string-array>

    <!-- Preference: Theme Value -->
    <string-array name="themeEntryArray">
